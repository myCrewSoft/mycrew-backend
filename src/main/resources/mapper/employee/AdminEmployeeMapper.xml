        D.LAST_MDFCN_DT AS DEPARTMENT_LAST_MDFCN_DT,
        D.LAST_MDFR_ID AS DEPARTMENT_LAST_MDFR_ID,
        JP.JOB_PSTN_CD AS JOB_POSITION_JOB_PSTN_CD,
