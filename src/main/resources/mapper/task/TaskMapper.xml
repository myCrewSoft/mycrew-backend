<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mycrewsoft.domain.task.mapper.TaskMapper">

    <resultMap id="TaskAuthContextResultMap" type="com.mycrewsoft.domain.task.vo.TaskVO">
        <id property="taskId" column="TASK_ID"/>
        <result property="projId" column="PROJ_ID"/>
        <result property="taskMngrId" column="TASK_MNGR_ID"/>
    </resultMap>

    <select id="selectTaskAuthContextByTaskId" resultMap="TaskAuthContextResultMap">
        SELECT
            TASK_ID,
            PROJ_ID,
            TASK_MNGR_ID
        FROM TB_TASK
        WHERE TASK_ID = #{taskId}
          AND NVL(DEL_YN, 'N') = 'N'
    </select>
</mapper>
